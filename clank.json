{
  "extends": ["claude-code-hardened"],
  "meta": {
    "name": "clank",
    "version": "",
    "description": "Secure base profile for Claude Code: keychain denied, package-manager caches redirected under /tmp/claude-$UID (already writable via the inherited claude-code-hardened profile), auth token injected from 1Password. No kube/orbstack access (see clank-kube / clank-docker / clank-orbstack).",
    "author": "polarsquad"
  },
  "filesystem": {
    "suppress_save_prompt": [
      "/Users",
      "~/",
      "~/.ansible",
      "~/.aws",
      "~/.aws/config",
      "~/Applications/Claude Code URL Handler.app/Contents/MacOS",
      "~/Library/Application Support/Arc/User Data",
      "~/Library/Application Support/BraveSoftware/Brave-Browser",
      "~/Library/Application Support/Chromium",
      "~/Library/Application Support/Google/Chrome",
      "~/Library/Application Support/Microsoft Edge",
      "~/Library/Application Support/Vivaldi",
      "~/Library/Application Support/com.operasoftware.Opera",
      "~/Temp"
    ]
  },
  "env_credentials": {
    "op://Employee/Claude Code/credential": "CLAUDE_CODE_OAUTH_TOKEN"
  },
  "workdir": {
    "access": "readwrite"
  }
}
